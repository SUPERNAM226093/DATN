{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://localhost:8081/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "http://localhost:8081/images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}