{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://silent-vector-chi-steven.trycloudflare.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://silent-vector-chi-steven.trycloudflare.com/images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}